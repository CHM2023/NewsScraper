# Copy to .env and fill in. NEVER commit .env.

# --- Supabase (Project Settings -> API) ---
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Server-side key. Bypasses row level security, so never ship it to a browser.
# Supabase now labels this a "Secret key" (sb_secret_...) under Settings ->
# API Keys. SUPABASE_SECRET_KEY is accepted as an alias for this name.
SUPABASE_SERVICE_KEY=

# Postgres connection string, used ONLY to apply sql/*.sql from a workstation.
# Supabase -> Connect -> Session pooler URI, with the password filled in and
# percent-encoded. No workflow needs this, so it is not a repository secret.
DATABASE_URL=

# --- FRED (https://fredaccount.stlouisfed.org/apikeys) ---
# Free, instant. Used for release dates, actuals and daily prices.
FRED_API_KEY=

# --- Telegram (talk to @BotFather -> /newbot) ---
# Bot token, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# Numeric chat id to send to. Get it from @userinfobot, or from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot.
TELEGRAM_CHAT_ID=
