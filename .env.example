# Copy to .env and fill in. NEVER commit .env.

# --- Supabase (Project Settings -> API) ---
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# service_role key. Server-side only: it bypasses row level security.
SUPABASE_SERVICE_KEY=

# --- FRED (https://fredaccount.stlouisfed.org/apikeys) ---
# Free, instant. Used for release dates, actuals and daily prices.
FRED_API_KEY=

# --- Telegram (talk to @BotFather -> /newbot) ---
# Bot token, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# Numeric chat id to send to. Get it from @userinfobot, or from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot.
TELEGRAM_CHAT_ID=
